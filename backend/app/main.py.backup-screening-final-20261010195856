# =====================================================
# EXISTING PEOPLE ENDPOINT
# Uses the original database
# =====================================================

@app.get("/people")
def get_people(
    db: Session = Depends(get_db),
    current_admin=Depends(get_current_admin),
):
    people = db.query(Person).all()

    return [
        {
            "id": person.id,
            "full_name": person.full_name,
            "identity_number": person.identity_number,
            "date_of_birth": person.date_of_birth,
            "gender": person.gender,
        }
        for person in people
    ]

# =====================================================
# EXISTING DOCUMENTS ENDPOINT
# Uses the original database
# =====================================================

@app.get("/documents")
def get_documents(
    db: Session = Depends(get_db),
    current_admin=Depends(get_current_admin),
):
    documents = db.query(IdentityDocument).all()

    return [
        {
            "id": document.id,
            "person_id": document.person_id,
            "document_type": document.document_type,
            "document_number": document.document_number,
            "file_hash": document.file_hash,
            "created_at": document.created_at,
            "updated_at": document.updated_at,
        }
        for document in documents
    ]

# =====================================================
# EXISTING WATCHLIST ENDPOINT
# Uses the original database
# =====================================================

@app.get("/watchlist")
def get_watchlist(
    db: Session = Depends(get_db),
    current_admin=Depends(get_current_admin),
):
    records = db.query(Watchlist).all()

    return [
        {
            "id": record.id,
            "reference_id": record.reference_id,
            "name": record.name,
            "reason": record.reason,
            "status": record.status,
        }
        for record in records
    ]

# =====================================================
# EXISTING AUDIT ENDPOINT
# =====================================================

@app.get("/audit")
def get_audit_logs(
    db: Session = Depends(get_db),
    current_admin=Depends(get_current_admin),
):
    records = (
        db.query(Audit)
        .order_by(Audit.id.desc())
        .all()
    )

    return [
        {
            "id": record.id,
            "username": record.username,
            "action": record.action,
            "details": record.details,
            "timestamp": record.timestamp,
            "previous_hash": record.previous_hash,
            "record_hash": record.record_hash,
        }
        for record in records
    ]

# =====================================================
# EXISTING AUDIT INTEGRITY ENDPOINT
